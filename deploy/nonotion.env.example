# Configuración de NoNotion. Copia en /etc/nonotion.env (chmod 600, propietario root).
# El servicio la lee al arrancar: tras cambiarla, `systemctl restart nonotion`.

# URL pública con la que entras (sin barra final). Necesaria para el login con GitHub.
PUBLIC_URL=https://nonotion.tudominio.com

# ---- Login con GitHub (OAuth) ----
# Crea una OAuth App en https://github.com/settings/applications/new con:
#   Homepage URL:               la PUBLIC_URL de arriba
#   Authorization callback URL: <PUBLIC_URL>/auth/github/callback
# Mientras el login no esté completo, la app NO deja entrar a nadie (falla
# cerrada, nunca abierta). Para usarla sin login (solo si está detrás de
# Cloudflare Access y el puerto no es accesible de otra forma), descomenta:
# AUTH_MODE=off
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Propietarios de la instancia (cuentas de GitHub, separadas por comas): ven
# todos los espacios y crean espacios nuevos. Al resto de personas se les da
# acceso por espacio desde la app (Ajustes del espacio → Miembros).
AUTH_ALLOWED_GITHUB_USERS=tu-usuario-de-github

# Nombre del espacio inicial (solo se usa al crearlo, en el primer arranque)
# DEFAULT_WORKSPACE_NAME=Principal

# Interfaz en la que escucha (por defecto, todas). Si cloudflared corre en la
# misma máquina, usa 127.0.0.1; si corre en otro contenedor, deja el valor por
# defecto y limita el puerto 3000 con el cortafuegos a la IP de cloudflared.
# HOST=127.0.0.1
